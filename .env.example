# FLIRTY environment configuration
# Copy to .env and adjust. Never commit secrets.

# Required
DATABASE_URL="postgresql://flirty:flirty_dev_local@127.0.0.1:5432/flirty?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
SESSION_SECRET="replace-with-a-64-character-random-string-for-production"
APP_URL="http://localhost:3000"

# Runtime
NODE_ENV="development"
PORT="3000"

# Self-hosted file storage (local disk by default; MinIO/S3-compatible optional)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./data/uploads"
# STORAGE_S3_ENDPOINT="http://127.0.0.1:9000"
# STORAGE_S3_BUCKET="flirty"
# STORAGE_S3_ACCESS_KEY=""
# STORAGE_S3_SECRET_KEY=""
# STORAGE_S3_REGION="us-east-1"

# Optional email transport (local development adapter if unset)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="FLIRTY <noreply@localhost>"

# Development
SEED_ON_BOOT="false"
ENABLE_DEV_BILLING="true"
